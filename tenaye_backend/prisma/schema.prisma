datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model UserProfile {
  id                String              @id @default(uuid())
  email             String              @unique
  age               Int
  gender            String
  height            Float
  weight            Float
  bloodType         String
  activityLevel     String
  budgetRange       String
  medicalConditions Json                
  healthGoals       Json                
  allergies         Json                
  availableFoods    Json                // Added to match your frontend food list layout
  medications       Medication[]
  moodLogs          MoodLog[]
  nutritionPlans    NutritionPlan[]
  fitnessPlans      FitnessPlan[]
  emergencyContacts EmergencyContact[]
  weightLogs        WeightLog[]
  healthMetrics     HealthMeasurement[]
  chatMessages      ChatMessage[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model HealthMeasurement {
  id           String      @id @default(uuid())
  userId       String
  user         UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String      
  value        String      
  notes        String?
  createdAt    DateTime    @default(now())
}

model WeightLog {
  id        String      @id @default(uuid())
  userId    String
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float
  photoUrl  String?     
  createdAt DateTime    @default(now())
}

model Medication {
  id        String      @id @default(uuid())
  userId    String
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  dosage    String
  frequency String
  times     Json        
  startDate DateTime
  endDate   DateTime
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model MoodLog {
  id           String      @id @default(uuid())
  userId       String
  user         UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedMood String
  energyLevel  Int
  stressLevel  Int
  sleepHours   Int
  notes        String?
  createdAt    DateTime    @default(now())
}

model NutritionPlan {
  id                 String      @id @default(uuid())
  userId             String
  user               UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawIngredients     String
  dailyCalorieTarget Int
  mealScheduleJson   Json
  createdAt          DateTime    @default(now())
}

model FitnessPlan {
  id                   String      @id @default(uuid())
  userId               String
  user                 UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyGoal           String
  scheduleTimelineJson Json
  createdAt            DateTime    @default(now())
}

model EmergencyContact {
  id           String      @id @default(uuid())
  userId       String
  user         UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phoneNumber  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model ChatMessage {
  id        String      @id @default(uuid())
  userId    String
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String      // 'user' or 'ai'
  content   String      @db.Text
  createdAt DateTime    @default(now())
}